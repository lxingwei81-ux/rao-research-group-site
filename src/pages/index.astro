---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications, site } from '../lib/data';
import { withBase } from '../lib/paths';

const research = (await getCollection('research')).filter((item) => item.data.published).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).filter((item) => item.data.published).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const selectedPublications = publications.filter((publication) => publication.featured).slice(0, 5);
---

<BaseLayout description={site.lab_description || undefined}>
  <section class="page">
    <div class="home-layout">
      <div>
        <h1>Rao Research Group</h1>
        <p class="lead">{site.lab_description}</p>
        <p>We work at the intersection of functional materials chemistry, flexible electronics and bioengineering. The group develops bio-integrated electronic systems for personalized medicine, wearable health monitoring and human-machine interfaces.</p>
        <p>Additional group information, photographs and laboratory details will be added as the group website develops.</p>
      </div>
      <figure class="home-photo">
        <img src={withBase('/images/research/Slide1.JPG')} alt="Representative research image" />
        <figcaption>Representative research image. Final laboratory or group photo to be added.</figcaption>
      </figure>
    </div>
  </section>

  <section class="page page--compact">
    <h2>News</h2>
    {news.length > 0 ? (
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <time datetime={item.data.date.toISOString()}>{item.data.date.toISOString().slice(0, 10)}</time>
            <a href={withBase(item.data.internal_url || '/news/')}>{item.data.title}</a>
          </li>
        ))}
      </ul>
    ) : <p>To be added.</p>}
  </section>

  <section class="page page--compact">
    <h2>Research</h2>
    <ul class="plain-list">
      {research.map((item) => <li><a href={withBase(`/research/#${item.id}`)}>{item.data.title}</a>: {item.data.short_description}</li>)}
    </ul>
  </section>

  <section class="page page--compact">
    <h2>Selected Publications</h2>
    <ol class="publication-list">
      {selectedPublications.map((publication) => (
        <li>
          <span class="publication-title">{publication.title}</span>
          <span>{publication.authors}</span>
          <span>{publication.journal}, {publication.year}.</span>
        </li>
      ))}
    </ol>
    <p><a href={withBase('/publications/')}>More publications</a></p>
  </section>
</BaseLayout>
