---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const news = (await getCollection('news')).filter((item) => item.data.published).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="News" description="News and updates from the Rao Research Group.">
  <section class="page">
    <h1>News</h1>
    {news.length > 0 ? (
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <time datetime={item.data.date.toISOString()}>{item.data.date.toISOString().slice(0, 10)}</time>
            {item.data.internal_url || item.data.external_url ? <a href={item.data.external_url || withBase(item.data.internal_url || '/')}>{item.data.title}</a> : <span>{item.data.title}</span>}
            <p>{item.data.summary}</p>
          </li>
        ))}
      </ul>
    ) : <p>To be added.</p>}
  </section>
</BaseLayout>
