---
import BaseLayout from '../layouts/BaseLayout.astro';
import { positions, site } from '../lib/data';
import { withBase } from '../lib/paths';

const applicationEmail = site.contact_email || 'zhoulrao@cityu.edu.hk';
const applicationSubject = '[Application - Position Title] - Your Name';
const mailtoHref = `mailto:${applicationEmail}?subject=${encodeURIComponent(applicationSubject)}`;
const researchDirections = [
  {
    title: '柔性与可拉伸电子材料',
    description: '结合高分子化学、纳米功能材料与微纳加工技术，构建本征可拉伸电子器件、功能杂化材料及高密度阵列。'
  },
  {
    title: '生物电子界面与界面化学',
    description: '调控生物组织-电学界面，优化生物信号记录与光电刺激。'
  },
  {
    title: '自适应无线生物电子系统',
    description: '面向精准治疗与实时诊断监测，开发微创、无线化生物电子设备。'
  }
];
---

<BaseLayout title="Join Us" description="Opportunities with the Rao Research Group.">
  <section class="page-intro recruitment-intro">
    <div class="container recruitment-intro__grid">
      <div>
        <p class="eyebrow">Join Us</p>
        <h1>招收博士后、博士生和研究助理。</h1>
        <p>香港城市大学化学系饶州铝博士课题组诚聘 Postdoctoral Fellow、Ph.D. Student（2027 年秋季入学）及 Research Assistant（可随时到岗）。</p>
      </div>
      <a class="institution-strip" href={site.department_url || site.institution_url}>
        <img src={withBase('/images/institution/cityu-chemistry-logo.png')} alt="Department of Chemistry, City University of Hong Kong" />
        <span>Department of Chemistry · City University of Hong Kong</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="research-direction-grid">
        {researchDirections.map((direction) => (
          <article class="research-direction">
            <p class="eyebrow">Research Direction</p>
            <h2>{direction.title}</h2>
            <p>{direction.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      {positions.length > 0 ? (
        <div class="position-grid">
          {positions.map((position) => (
            <article class="position-card">
              <div class="position-card__top">
                <p class="position-card__status">{position.status}</p>
                {position.start && <p class="position-card__start">{position.start}</p>}
              </div>
              <h2>{position.position}</h2>
              {position.intro && <p>{position.intro}</p>}
              {position.description && <p>{position.description}</p>}
              {position.requirements && position.requirements.length > 0 && (
                <div class="position-card__list">
                  <h3>Requirements</h3>
                  <ul>{position.requirements.map((requirement) => <li>{requirement}</li>)}</ul>
                </div>
              )}
              {position.application_documents && position.application_documents.length > 0 && (
                <div class="position-card__list">
                  <h3>Application Materials</h3>
                  <ul>{position.application_documents.map((document) => <li>{document}</li>)}</ul>
                </div>
              )}
            </article>
          ))}
        </div>
      ) : <p class="empty-state">There are no published opportunities at this time.</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="application-panel">
        <div>
          <p class="eyebrow">Application</p>
          <h2>How to apply</h2>
          <p>请将申请材料合并为单个 PDF 文件发送至邮箱 <a href={`mailto:${applicationEmail}`}>{applicationEmail}</a>。</p>
          <p>邮件主题请注明：<strong>{applicationSubject}</strong></p>
        </div>
        <a class="button button--primary" href={mailtoHref}>Email application <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
