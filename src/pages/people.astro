---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RaoProfile from '../components/RaoProfile.astro';
import { withBase } from '../lib/paths';
const people = (await getCollection('people')).filter(p => p.data.published).sort((a,b)=>a.data.order-b.data.order);
const pi = people.find(p=>p.data.group==='Principal Investigator');
const groups = ['Postdoctoral Fellows','PhD Students','Research Staff','Visiting Researchers','Alumni'].map(name=>({name,members:people.filter(p=>p.data.group===name)})).filter(g=>g.members.length);
---
<BaseLayout title="People" description="Meet our lab and learn about our research interests and background.">
<section class="page">
  <div id="pi">{pi && <RaoProfile profile={pi} />}</div>
  {groups.map(group=><section class="cv-section"><h2>{group.name}</h2><div class="member-grid">{group.members.map(member=><article>{member.data.photo && <img src={withBase(member.data.photo)} alt={member.data.name} loading="lazy" width="220" height="220" />}<h3>{member.data.name}</h3><p>{member.data.role}</p>{member.data.bio && <p>{member.data.bio}</p>}{member.data.email && <a href={'mailto:'+member.data.email}>Email ↗</a>}</article>)}</div></section>)}
  <section class="application-note"><h2>Join our lab</h2><p>Interested in working with us? Explore our <a href={withBase('/positions/')}>open positions</a>.</p></section>
</section>
</BaseLayout>
