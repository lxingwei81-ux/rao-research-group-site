---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RaoProfile from '../components/RaoProfile.astro';

const people = (await getCollection('people')).filter((person) => person.data.published).sort((a, b) => a.data.order - b.data.order);
const principalInvestigator = people.find((person) => person.data.group === 'Principal Investigator');
const teamMembers = principalInvestigator ? people.filter((person) => person.id !== principalInvestigator.id) : people;
---

<BaseLayout title="People" description="People in the Rao Research Group.">
  <section class="page">
    {principalInvestigator ? <RaoProfile profile={principalInvestigator} /> : <p>To be added.</p>}

    <h2>Group Members</h2>
    {teamMembers.length > 0 ? (
      <ul class="plain-list">
        {teamMembers.map((person) => <li>{person.data.name}, {person.data.role}</li>)}
      </ul>
    ) : <p>To be added.</p>}

    <h2>Alumni</h2>
    <p>To be added.</p>
  </section>
</BaseLayout>
