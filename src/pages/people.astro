---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import CTA from '../components/CTA.astro';
import { withBase } from '../lib/paths';

const groupOrder = ['Principal Investigator', 'Postdoctoral Fellows', 'PhD Students', 'Research Staff', 'Visiting Researchers', 'Alumni'];
const people = (await getCollection('people')).filter((person) => person.data.published).sort((a, b) => a.data.order - b.data.order);
const principalInvestigator = people.find((person) => person.data.group === 'Principal Investigator');
const teamMembers = principalInvestigator ? people.filter((person) => person.id !== principalInvestigator.id) : people;
const groupedPeople = groupOrder.map((group) => ({ group, people: teamMembers.filter((person) => person.data.group === group) })).filter((item) => item.people.length > 0);
---

<BaseLayout title="People" description="People in the Rao Research Group.">
  <section class="page-intro"><div class="container"><p class="eyebrow">People</p><h1>Our research community.</h1><p>Meet the researchers building flexible, bio-integrated electronic systems at City University of Hong Kong.</p></div></section>

  {principalInvestigator && (
    <section class="section">
      <div class="container">
        <article class="profile-feature">
          <div class="profile-feature__portrait">
            {principalInvestigator.data.photo && <img src={withBase(principalInvestigator.data.photo)} alt={`Portrait of ${principalInvestigator.data.name}`} />}
          </div>
          <div class="profile-feature__main">
            <p class="eyebrow">Principal Investigator</p>
            <h2>{principalInvestigator.data.name}</h2>
            <p class="profile-feature__role">{principalInvestigator.data.role}</p>
            {principalInvestigator.data.bio && <p>{principalInvestigator.data.bio}</p>}
            <div class="profile-feature__links">
              {principalInvestigator.data.email && <a class="text-link" href={`mailto:${principalInvestigator.data.email}`}>Email <span aria-hidden="true">→</span></a>}
              {principalInvestigator.data.personal_url && <a class="text-link" href={principalInvestigator.data.personal_url}>CityU profile <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
          <dl class="profile-facts">
            {principalInvestigator.data.research_interest && <div><dt>Research Interests</dt><dd>{principalInvestigator.data.research_interest}</dd></div>}
            {principalInvestigator.data.office && <div><dt>Office</dt><dd>{principalInvestigator.data.office}</dd></div>}
            {principalInvestigator.data.phone && <div><dt>Phone</dt><dd>{principalInvestigator.data.phone}</dd></div>}
          </dl>
        </article>

        <div class="profile-detail-grid">
          {principalInvestigator.data.education.length > 0 && (
            <section>
              <h2>Education</h2>
              <ul>{principalInvestigator.data.education.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}
          {principalInvestigator.data.experience.length > 0 && (
            <section>
              <h2>Training</h2>
              <ul>{principalInvestigator.data.experience.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}
          {principalInvestigator.data.academic_appointments.length > 0 && (
            <section>
              <h2>Academic Appointment</h2>
              <ul>{principalInvestigator.data.academic_appointments.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section section--muted"><div class="container">
    <p class="eyebrow">Group Members</p>
    {groupedPeople.length > 0 ? groupedPeople.map((section) => <section class="people-group"><h2 class="people-group__title">{section.group}</h2><div class="people-grid">{section.people.map((person) => <PersonCard person={person} />)}</div></section>) : <p class="empty-state">Additional group member profiles will be added as the lab grows.</p>}
  </div></section>
  <div class="container section section--compact"><CTA /></div>
</BaseLayout>
