---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import Authors from '../components/Authors.astro';
import PublicationMetadata from '../components/PublicationMetadata.astro';
import { publications } from '../lib/data';
import { withBase } from '../lib/paths';
const years = [...new Set(publications.map(p=>p.year))].sort((a,b)=>b-a);
const areas = [...new Set(publications.map(p=>p.research_area).filter(Boolean))];
---
<BaseLayout title="Publications" description="Explore our research highlights and publications, organized by year.">
<section class="page"><h1>Publications</h1>
<h2>Selected publications</h2><div class="highlights-grid">{publications.filter(p=>p.featured).slice(0,6).map(publication=><PublicationCard publication={publication} />)}</div>
<h2 id="full-list">Complete list by year</h2>
<nav class="year-nav" aria-label="Publication years">{years.map(year=><a href={'#year-'+year}>{year}</a>)}</nav>
<form class="publication-filters" role="search" onsubmit="return false" hidden data-filters>
<label>Search publications<input type="search" name="query" placeholder="Title, author or journal" data-query /></label>
<label>Research area<select name="area" data-area><option value="">All research areas</option>{areas.map(area=><option value={area}>{area}</option>)}</select></label>
<label>Year<select name="year" data-year><option value="">All years</option>{years.map(year=><option value={year}>{year}</option>)}</select></label>
<button class="button" type="reset">Clear filters</button>
</form>
<p role="status" aria-live="polite" data-results hidden></p>
{years.map(year=><section class="publication-year" id={'year-'+year} data-year-group><h2>{year}</h2><ol class="publication-list">{publications.filter(p=>p.year===year).map(p=>{
const destination=p.doi?'https://doi.org/'+p.doi:p.url;
return <li id={p.id} data-publication data-year={p.year} data-area={p.research_area || ''} data-search={(p.title+' '+p.authors.replace(/Zhoulyu Rao|Zhoulv Rao/g, 'Zhoulyu Rao Zhoulv Rao')+' '+p.journal).toLowerCase()}>
  <p class="publication-reference"><span class="authors"><Authors authors={p.authors} /></span>, {' '}
    {destination ? <a class="publication-title" href={destination}>{p.title}</a> : p.title}, {' '}
    <PublicationMetadata publication={p} />.
  </p>
  {p.pdf_url && <div class="publication-links"><a href={withBase(p.pdf_url)}>PDF ↗</a></div>}
</li>;
})}</ol></section>)}
</section>
</BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('[data-filters]');
if(form){
form.hidden=false;
const query=form.querySelector<HTMLInputElement>('[data-query]')!;
const area=form.querySelector<HTMLSelectElement>('[data-area]')!;
const year=form.querySelector<HTMLSelectElement>('[data-year]')!;
const items=[...document.querySelectorAll<HTMLElement>('[data-publication]')];
const status=document.querySelector<HTMLElement>('[data-results]')!;
const update=()=>{
let count=0;
for(const item of items){item.hidden=!(query.value.toLowerCase().trim().split(/\s+/).every(term=>item.dataset.search!.includes(term)) && (!area.value || item.dataset.area===area.value) && (!year.value || item.dataset.year===year.value));if(!item.hidden)count++;}
document.querySelectorAll<HTMLElement>('[data-year-group]').forEach(group=>group.hidden=![...group.querySelectorAll<HTMLElement>('[data-publication]')].some(i=>!i.hidden));
status.hidden=false;status.textContent=count?count+' publications shown.':'No publications match these filters. Try another search or clear the filters.';
};
form.addEventListener('input',update);
form.addEventListener('reset',()=>setTimeout(update,0));
document.querySelectorAll<HTMLAnchorElement>('.year-nav a').forEach(a=>a.addEventListener('click',()=>{form.reset();query.value='';area.value='';year.value='';update();}));
}
</script>
