---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications, publicationCitation } from '../lib/data';

const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
const groupedPublications = years.map((year) => ({
  year,
  items: publications.filter((publication) => publication.year === year)
}));
---

<BaseLayout title="Publications" description="Publications from the Rao Research Group.">
  <section class="page">
    <h1>Publications</h1>
    <p class="lead">Publication records are listed by year. DOI and publisher links will be added where available.</p>

    {groupedPublications.map((group) => (
      <section class="publication-year">
        <h2>{group.year}</h2>
        <ol class="publication-list">
          {group.items.map((publication) => {
            const destination = publication.url || (publication.doi ? `https://doi.org/${publication.doi}` : undefined);
            return (
              <li id={publication.id}>
                <span class="publication-title">{destination ? <a href={destination}>{publication.title}</a> : publication.title}</span>
                <span>{publication.authors}</span>
                <span><em>{publicationCitation(publication)}</em></span>
                {publication.equal_contribution_note && <span>{publication.equal_contribution_note}</span>}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>
</BaseLayout>
