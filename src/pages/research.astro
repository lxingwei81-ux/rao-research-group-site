---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../lib/data';
import { withBase } from '../lib/paths';

const research = (await getCollection('research')).filter((item) => item.data.published).sort((a, b) => a.data.order - b.data.order);
const publicationById = new Map(publications.map((publication) => [publication.id, publication]));
---

<BaseLayout title="Research" description="Explore our work in bioelectronics, stretchable materials and shape-adaptive optoelectronic systems.">
  <section class="page">
    <h1>Research</h1>
    <p class="lead">Our work brings together materials chemistry, soft electronics and bioengineering.</p>

    {research.map((item) => {
      const representativePublications = item.data.representative_publications.map((id) => publicationById.get(id)).filter(Boolean);
      return <article class="research-entry" id={item.id}>
        <div>
          <h2>{item.data.title}</h2>
          <p>{item.data.short_description}</p>
          {representativePublications.length > 0 && <div class="research-publications">
            <h3>Related publications</h3>
            <ul>{representativePublications.map((publication: any) => <li><a href={withBase('/publications/#' + publication.id)}>{publication.title}</a> ({publication.year})</li>)}</ul>
          </div>}
        </div>
      </article>;
    })}
  </section>
</BaseLayout>
