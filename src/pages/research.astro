---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PublicationCard from '../components/PublicationCard.astro';
import CTA from '../components/CTA.astro';
import { publications } from '../lib/data';
import { withBase } from '../lib/paths';

const research = (await getCollection('research')).filter((item) => item.data.published).sort((a, b) => a.data.order - b.data.order);
const publicationById = new Map(publications.map((publication) => [publication.id, publication]));
---

<BaseLayout title="Research" description="Research themes in bioelectronics, soft electronics and curvy optoelectronic systems.">
  <section class="page-intro"><div class="container"><p class="eyebrow">Research</p><h1>Science shaped for biological systems.</h1><p>Our research explores how materials, device architecture and form factor can bring engineered electronic systems into closer contact with living systems and curved environments.</p></div></section>

  <section class="section section--muted">
    <div class="container"><div class="research-grid">{research.map((item) => <ResearchCard item={item} />)}</div></div>
  </section>

  <section class="section"><div class="container">
    {research.map((item) => {
      const representativePublications = item.data.representative_publications.map((id) => publicationById.get(id)).filter(Boolean);
      return <article class="research-detail" id={item.id}>
        <div>
          <p class="eyebrow">{item.data.title}</p>
          <h2>{item.data.short_description}</h2>
          {item.data.image && <figure class="research-detail__media"><img src={withBase(item.data.image)} alt="" /></figure>}
        </div>
        <div class="research-detail__content">
          <div class="research-detail__step"><h3>Scientific question</h3><p>{item.data.question}</p></div>
          <div class="research-detail__step"><h3>Approach</h3><p>{item.data.approach}</p></div>
          <div class="research-detail__step"><h3>Materials / devices</h3><p>{item.data.materials_devices}</p></div>
          <div class="research-detail__step"><h3>Application</h3><p>{item.data.application}</p></div>
          {representativePublications.length > 0 && <div class="research-detail__step"><h3>Representative publications</h3><ul class="research-detail__publications">{representativePublications.map((publication: any) => <li><a href={withBase(`/publications/#${publication.id}`)}>{publication.title}</a> <span>({publication.year})</span></li>)}</ul></div>}
        </div>
      </article>;
    })}
  </div></section>
  <div class="container section section--compact"><CTA /></div>
</BaseLayout>
