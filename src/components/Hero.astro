---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const isDraft = import.meta.env.DEV;
const visibleTitle = title || (isDraft ? '[CONTENT NEEDED: LAB TAGLINE]' : '');
const visibleDescription = description || (isDraft ? '[CONTENT NEEDED: LAB DESCRIPTION]' : '');
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content reveal">
      <p class="eyebrow">Materials · Devices · Biology</p>
      {visibleTitle && <h1>{visibleTitle}</h1>}
      {visibleDescription && <p class:list={['hero__description', { 'draft-copy': !title || !description }]}>{visibleDescription}</p>}
      <div class="hero__actions">
        <a class="button button--primary" href="/research/">Explore Research <span aria-hidden="true">→</span></a>
        <a class="button button--quiet" href="/join-us/">Join Us <span aria-hidden="true">→</span></a>
      </div>
    </div>
    {image ? (
      <figure class="hero__figure reveal">
        <img src={image} alt="Scientific image from the group's previous research" />
      </figure>
    ) : isDraft ? <div class="hero__image-placeholder">[IMAGE NEEDED: HERO RESEARCH IMAGE]</div> : null}
  </div>
</section>
