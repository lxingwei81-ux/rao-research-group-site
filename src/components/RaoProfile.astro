---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
import { site } from '../lib/data';
interface Props { profile: CollectionEntry<'people'> }
const { profile } = Astro.props;
const p=profile.data;
const sections=[{title:'Education',items:p.education},{title:'Postdoctoral training',items:p.experience},{title:'Appointments',items:p.academic_appointments},{title:'Selected awards & honors',items:p.selected_awards_honors},{title:'Editorial service',items:p.editorial_service}].filter(s=>s.items.length);
---
<article class="rao-profile">
<div class="rao-profile__text"><h1>Zhoulyu Rao</h1><p class="profile-name">{p.role}</p><p>{p.affiliations.join(' · ')}</p>{p.bio && <p>{p.bio}</p>}
<ul class="profile-lines profile-lines--contact">
{p.email && <li><strong>Email:</strong> <a href={'mailto:'+p.email}>{p.email}</a></li>}
{p.office && <li><strong>Office:</strong> {p.office}</li>}
{p.lab_locations.length > 0 && <li><strong>Lab:</strong> {p.lab_locations.join('; ')}</li>}
{p.phone && <li><strong>Phone:</strong> <a href={'tel:'+p.phone.replace(/[^+\d]/g,'')}>{p.phone}</a></li>}
</ul><div class="publication-links">{p.personal_url && <a href={p.personal_url}>CityUHK profile ↗</a>}{site.orcid_url && <a href={site.orcid_url}>ORCID ↗</a>}{site.scholar_url && <a href={site.scholar_url}>Google Scholar ↗</a>}</div></div>
{p.photo && !p.photo.includes('placeholder') && <div class="rao-profile__media"><img src={withBase(p.photo)} alt={'Portrait of '+p.name} width="220" height="220" /></div>}
</article>
{p.research_interest && <section class="cv-section"><h2>Research interests</h2><p>{p.research_interest}</p></section>}
{sections.map(section=><section class="cv-section"><h2>{section.title}</h2><ul class="square-list">{section.items.map(item=><li>{item}</li>)}</ul></section>)}
