---
interface Props {
  item: any;
}
const { item } = Astro.props;
---

<article class="research-card reveal" id={item.id}>
  {item.data.image && <div class="research-card__image"><img src={item.data.image} alt="" /></div>}
  <div class="research-card__body">
    <p class="eyebrow">Research theme</p>
    <h3>{item.data.title}</h3>
    <p>{item.data.short_description}</p>
    <a class="text-link" href={`/research/#${item.id}`}>Explore theme <span aria-hidden="true">→</span></a>
  </div>
</article>
