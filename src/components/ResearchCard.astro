---
import { withBase } from '../lib/paths';

interface Props {
  item: any;
}
const { item } = Astro.props;
---

<article class="research-card" id={item.id}>
  {item.data.image && <div class="research-card__image"><img src={withBase(item.data.image)} alt="" /></div>}
  <div class="research-card__body">
    <h3>{item.data.title}</h3>
    <p>{item.data.short_description}</p>
    <a class="text-link" href={withBase(`/research/#${item.id}`)}>More</a>
  </div>
</article>
