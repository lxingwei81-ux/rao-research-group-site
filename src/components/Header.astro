---
import { site } from '../lib/data';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const navigation = [
  { label: 'Home', href: '/' },
  { label: 'Dr. Rao', href: '/dr-rao/' },
  { label: 'Research', href: '/research/' },
  { label: 'People', href: '/people/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Positions', href: '/positions/' },
  { label: 'News', href: '/news/' }
].map((item) => ({ ...item, href: withBase(item.href) }));
const labName = site.lab_name || site.site_name;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-title" href={withBase('/')}>
      <span>{labName}</span>
    </a>
    <a class="institution-lockup" href={site.institution_url} aria-label={`${site.institution} homepage`}>
      {site.official_logo ? <img src={withBase(site.official_logo)} alt={`${site.institution} logo`} /> : <span>{site.institution}</span>}
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span class="sr-only">Toggle navigation</span>
      <span></span><span></span><span></span>
    </button>
    <nav id="site-navigation" class="site-navigation" aria-label="Primary navigation" data-site-navigation>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-site-navigation]');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open', !isOpen);
  });
</script>
