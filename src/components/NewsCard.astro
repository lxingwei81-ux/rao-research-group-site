---
import { withBase } from '../lib/paths';

interface Props { item: any; }
const { item } = Astro.props;
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' }).format(item.data.date);
---

<article class="news-card reveal">
  {item.data.image && <img src={withBase(item.data.image)} alt="" loading="lazy" />}
  <div>
    <p class="publication-card__meta">{date}</p>
    <h3>{item.data.external_url ? <a href={item.data.external_url}>{item.data.title}</a> : item.data.title}</h3>
    <p>{item.data.summary}</p>
    {item.data.external_url && <a class="text-link" href={item.data.external_url}>Read more <span aria-hidden="true">→</span></a>}
  </div>
</article>
