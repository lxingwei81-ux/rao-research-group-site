---
import { withBase } from '../lib/paths';

interface Props { person: any; }
const { person } = Astro.props;
---

<article class="person-card reveal">
  {person.data.photo && <img class="person-card__image" src={withBase(person.data.photo)} alt={`Portrait of ${person.data.name}`} loading="lazy" />}
  <div class="person-card__body">
    <p class="eyebrow">{person.data.role}</p>
    <h3>{person.data.name}</h3>
    {person.data.bio && <p>{person.data.bio}</p>}
    {person.data.research_interest && <p class="person-card__interest"><strong>Research interests:</strong> {person.data.research_interest}</p>}
    {person.data.email && <a class="text-link" href={`mailto:${person.data.email}`}>Contact <span aria-hidden="true">→</span></a>}
    {person.data.personal_url && <a class="text-link" href={person.data.personal_url}>Profile <span aria-hidden="true">↗</span></a>}
  </div>
</article>
