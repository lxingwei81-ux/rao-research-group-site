---
import type { Publication } from '../lib/data';
import { withBase } from '../lib/paths';
import Authors from './Authors.astro';
import PublicationMetadata from './PublicationMetadata.astro';
interface Props { publication: Publication; compact?: boolean; }
const { publication, compact = false } = Astro.props;
const destination = publication.doi ? 'https://doi.org/'+publication.doi : publication.url;
---
<article class:list={['publication-card', { 'publication-card--compact': compact }]}>
  {publication.cover_image && !compact && <div class="publication-card__image"><img src={withBase(publication.cover_image)} alt={publication.image_alt || ''} loading="lazy" width="900" height="1200" /></div>}
  <div class="publication-card__body">
    <h3><a href={destination || withBase('/publications/#'+publication.id)}>{publication.title}</a></h3>
    <p class="publication-card__authors"><Authors authors={publication.authors} /></p>
    <p class="publication-card__citation"><PublicationMetadata publication={publication} />.</p>
    {publication.pdf_url && <div class="publication-links"><a href={withBase(publication.pdf_url)}>PDF</a></div>}
  </div>
</article>
